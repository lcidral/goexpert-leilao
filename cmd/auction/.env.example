# Exemplo de variáveis de ambiente para desenvolvimento

# Intervalos e tamanhos (ajuste conforme necessário)
BATCH_INSERT_INTERVAL=20s
MAX_BATCH_SIZE=4
AUCTION_INTERVAL=20s

# Configurações do fechamento automático
AUCTION_DEFAULT_DURATION_SEC=300
AUCTION_CLOSE_SCAN_INTERVAL_MS=1000

# MongoDB (o docker-compose usa estas variáveis no serviço mongodb)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin
MONGODB_URL=mongodb://admin:admin@mongodb:27017/auctions?authSource=admin
MONGODB_DB=auctions
